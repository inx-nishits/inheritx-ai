# Public site origin (canonicals, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=https://www.inheritx.com

# Contact lead delivery (required in production). The form never opens the
# visitor’s mail client. Set a webhook and/or Resend so inheritx receives the lead.
# Prefer a webhook into HubSpot/Salesforce/Zapier.
# When set, /api/contact POSTs JSON leads with Authorization: Bearer CONTACT_WEBHOOK_SECRET.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=

# Email delivery via Resend when no webhook is configured.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@inheritx.com
CONTACT_FROM_EMAIL=InheritX Website <hello@inheritx.com>

# Optional calendar embed on /contact. Leave empty — the contact form is the
# primary conversion path. Prospects submit the form to schedule manually.
NEXT_PUBLIC_CALENDLY_URL=

# Optional IRA chatbot URL. Must be https on a production host (not *.vercel.app).
# Leave empty to hide the floating IRA control.
NEXT_PUBLIC_IRA_CHAT_URL=

# Analytics vendor (optional). CTA events always queue on window.dataLayer
# and dispatch `inheritx:cta`. Set one of these to load GTM or GA4.
# Prefer GTM. Do not run A/B tests until a click baseline exists.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Distributed rate limiting for /api/contact (production-safe).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# WordPress Insights API (server-side). Prefer WP_API_BASE so the origin is
# not required in the browser bundle. NEXT_PUBLIC_WP_API_BASE remains a fallback.
WP_API_BASE=https://wpadmin.inheritx.com
NEXT_PUBLIC_WP_API_BASE=https://wpadmin.inheritx.com

# Contact deep links (no env required):
# /contact?intent=strategy
# /contact?intent=assessment
# /contact?intent=security

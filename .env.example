# =============================================================================
# Public site origin (canonicals, Open Graph, sitemap, robots, JSON-LD).
# Production: https://inheritx.ai
# =============================================================================
NEXT_PUBLIC_SITE_URL=https://inheritx.ai

# =============================================================================
# WordPress / CMS backend (server-only — never use NEXT_PUBLIC_ for this).
# This is the existing CMS/API source. Keep pointing at wpadmin.inheritx.com.
# The NEW frontend domain (inheritx.ai) is separate from this backend.
# =============================================================================
WP_API_BASE=https://wpadmin.inheritx.com

# =============================================================================
# Contact lead delivery (required in production).
# The form never opens the visitor's mail client.
# Option 1 — Webhook (HubSpot / Salesforce / Zapier / Make):
#   Set CONTACT_WEBHOOK_URL. The route will POST JSON leads with
#   Authorization: Bearer <CONTACT_WEBHOOK_SECRET> when set.
# Option 2 — Resend email:
#   Set RESEND_API_KEY. Lead is emailed to CONTACT_TO_EMAIL.
# At least one of CONTACT_WEBHOOK_URL or RESEND_API_KEY must be set in
# production, or the contact form will return 503 to every submission.
# =============================================================================
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=

RESEND_API_KEY=
CONTACT_TO_EMAIL=contact@inheritx.com
CONTACT_FROM_EMAIL=InheritX Website <contact@inheritx.com>
CAREERS_TO_EMAIL=careers@inheritx.com

# =============================================================================
# Optional calendar embed on /contact.
# Leave empty — the contact form is the primary conversion path.
# =============================================================================
NEXT_PUBLIC_CALENDLY_URL=

# =============================================================================
# IRA chatbot. Set to a production HTTPS host before go-live.
# Default fallback (used when empty): https://ira-chatbot-nine.vercel.app/
# Replace with a branded production URL, e.g. https://ira.inheritx.ai/
# =============================================================================
NEXT_PUBLIC_IRA_CHAT_URL=

# =============================================================================
# Analytics (optional but strongly recommended before go-live).
# CTA events always queue on window.dataLayer and dispatch `inheritx:cta`
# regardless. Set GTM_ID to load GTM. Set GA_MEASUREMENT_ID for standalone GA4.
# Prefer GTM. Both require cookie consent before loading.
# =============================================================================
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# =============================================================================
# Distributed rate limiting for /api/contact (production-safe).
# Without this, the rate limiter falls back to per-instance memory,
# which is NOT distributed and trivially bypassed on serverless platforms.
# Create a free Redis database at https://upstash.com/
# =============================================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# =============================================================================
# Contact deep links (no env required — these work as-is):
#   /contact?intent=strategy
#   /contact?intent=assessment
#   /contact?intent=security
# =============================================================================

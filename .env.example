# Contact lead delivery (CRM-ready). Prefer a webhook into HubSpot/Salesforce/Zapier.
# When set, /api/contact POSTs JSON leads with Authorization: Bearer CONTACT_WEBHOOK_SECRET.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=

# Optional email delivery via Resend when no webhook is configured.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@inheritx.com
CONTACT_FROM_EMAIL=InheritX Website <onboarding@resend.dev>

# Calendly (or equivalent) booking URL for the contact page embed.
# Example: https://calendly.com/your-org/ai-strategy-call
# Also used as conversion maturity signal on /contact.
NEXT_PUBLIC_CALENDLY_URL=

# Public site URL for canonical / Open Graph / JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.inheritx.com

# WordPress Insights API base (existing production backend — do not change path contracts).
NEXT_PUBLIC_WP_API_BASE=https://wpadmin.inheritx.com

# Contact deep links (no env required):
# /contact?intent=strategy
# /contact?intent=assessment
# /contact?intent=security
